OPENROUTER_API_KEY=
SEARCH_API_KEY=
# Postgres from compose.yaml. The tests create (and drop) their own database on TEST_DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Where photo uploads go: a local directory. Empty: the Cloud Storage bucket in GCS_BUCKET.
STORAGE_DIR=.data/uploads
# In production Terraform sets GCS_BUCKET to the <project>-uploads bucket.
GCS_BUCKET=app-data
# Where the API finds an agent. One plain server for all jobs (`uvicorn agent.server:app --port 8001`):
AGENT_URL=http://localhost:8001
# Or one Substrate actor per job, when AGENT_URL is empty. deploy/local/compose.yaml has all of them:
# ATE_ROUTER_URL, ATE_API_TARGET, ATE_ATESPACE, ATE_TEMPLATE_FILE, ATE_CA_FILE, ATE_CLIENT_CERT_FILE, ATE_TOKEN_FILE
# On Cloud Run the API signs in to ate-api with Google ID tokens for this audience instead of ATE_TOKEN_FILE; unset locally:
ATE_ID_TOKEN_AUDIENCE=
# The Firebase project whose ID tokens the API accepts. With the Auth emulator (`docker compose up -d auth`), which
# compose.yaml starts for the containerised API, use demo-justpass and the emulator's address (needs a demo-* project).
FIREBASE_PROJECT_ID=demo-justpass
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Signs the tokens the API gives agents for the Context API: 32+ random characters, e.g. `openssl rand -hex 32`.
CONTEXT_TOKEN_SECRET=
# Where agents reach the Context API. Empty: agents get no Context API and use the task in their request.
CONTEXT_API_URL=http://localhost:8000
