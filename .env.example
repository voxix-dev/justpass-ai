OPENROUTER_API_KEY=
SEARCH_API_KEY=
# Postgres from compose.yaml. The tests create (and drop) their own database on TEST_DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
GCS_BUCKET=app-data
# Where the API finds an agent. One plain server for all jobs (`uvicorn agent.server:app --port 8001`):
AGENT_URL=http://localhost:8001
# Or one Substrate actor per job, when AGENT_URL is empty. deploy/local/compose.yaml has all of them:
# ATE_ROUTER_URL, ATE_API_TARGET, ATE_ATESPACE, ATE_TEMPLATE, ATE_CA_FILE, ATE_CLIENT_CERT_FILE, ATE_TOKEN_FILE
FIREBASE_PROJECT_ID=
# Only with the Firebase Auth Emulator (e.g. localhost:9099); needs a demo-* FIREBASE_PROJECT_ID.
FIREBASE_AUTH_EMULATOR_HOST=
# Signs the tokens the API gives agents for the Context API: 32+ random characters, e.g. `openssl rand -hex 32`.
CONTEXT_TOKEN_SECRET=
# Where agents reach the Context API. Empty: agents get no Context API and use the task in their request.
CONTEXT_API_URL=http://localhost:8000
