{
  "components": {
    "schemas": {
      "ArtifactContent": {
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          },
          "content_md": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Md"
          },
          "kind": {
            "$ref": "#/components/schemas/ArtifactKind"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "round": {
            "title": "Round",
            "type": "integer"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "artifact_id",
          "title",
          "role",
          "kind",
          "round",
          "content_md"
        ],
        "title": "ArtifactContent",
        "type": "object"
      },
      "ArtifactKind": {
        "description": "What an agent wrote. Each round has at most one FINAL: the answer the student reviews.",
        "enum": [
          "research_notes",
          "outline",
          "draft",
          "review",
          "final",
          "test_summary"
        ],
        "title": "ArtifactKind",
        "type": "string"
      },
      "FeedbackCreate": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "FeedbackCreate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobCreate": {
        "additionalProperties": false,
        "description": "A job sent as text. Photo jobs get their own upload route, which also calls add_job().",
        "properties": {
          "language": {
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
            "title": "Language",
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "subject": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "text": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "level",
          "language",
          "text"
        ],
        "title": "JobCreate",
        "type": "object"
      },
      "JobDetail": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "input_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Text"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "photo_count": {
            "title": "Photo Count",
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "review_deadline": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Deadline"
          },
          "round": {
            "title": "Round",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "subject",
          "level",
          "language",
          "review_deadline",
          "created_at",
          "updated_at",
          "input_text",
          "photo_count",
          "round",
          "result"
        ],
        "title": "JobDetail",
        "type": "object"
      },
      "JobResult": {
        "properties": {
          "markdown": {
            "title": "Markdown",
            "type": "string"
          },
          "round": {
            "title": "Round",
            "type": "integer"
          }
        },
        "required": [
          "round",
          "markdown"
        ],
        "title": "JobResult",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "received",
          "processing",
          "awaiting_review",
          "accepted",
          "expired",
          "failed"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "JobSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "review_deadline": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Deadline"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "subject",
          "level",
          "language",
          "review_deadline",
          "created_at",
          "updated_at"
        ],
        "title": "JobSummary",
        "type": "object"
      },
      "Level": {
        "enum": [
          "high_school",
          "college"
        ],
        "title": "Level",
        "type": "string"
      },
      "ReadArtifact": {
        "description": "Read an artifact's full content by id.",
        "properties": {
          "artifact_id": {
            "maxLength": 100,
            "title": "Artifact Id",
            "type": "string"
          }
        },
        "required": [
          "artifact_id"
        ],
        "title": "ReadArtifact",
        "type": "object"
      },
      "Role": {
        "enum": [
          "orchestrator",
          "research",
          "writer",
          "solver",
          "review",
          "curator"
        ],
        "title": "Role",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WriteArtifact": {
        "description": "Save Markdown as a new artifact. Returns {artifact_id}.",
        "properties": {
          "content_md": {
            "maxLength": 200000,
            "title": "Content Md",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "content_md"
        ],
        "title": "WriteArtifact",
        "type": "object"
      },
      "WrittenArtifact": {
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          }
        },
        "required": [
          "artifact_id"
        ],
        "title": "WrittenArtifact",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Homework API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/jobs": {
      "get": {
        "description": "My jobs, most recently changed first: the newest 100, or all changed since `updated_since`.\n\nTo poll for changes, pass the newest `updated_at` you have seen as `updated_since`. The answer\nalso repeats the few seconds before it, so replace jobs you already have by id.",
        "operationId": "list_jobs_jobs_get",
        "parameters": [
          {
            "in": "query",
            "name": "updated_since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Updated Since"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobSummary"
                  },
                  "title": "Response List Jobs Jobs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Jobs",
        "tags": [
          "jobs"
        ]
      },
      "post": {
        "operationId": "create_job_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "get_job_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/jobs/{job_id}/accept": {
      "post": {
        "description": "Accepts the answer. This is final: no more feedback after it.",
        "operationId": "accept_job_jobs__job_id__accept_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Accept Job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/jobs/{job_id}/feedback": {
      "post": {
        "description": "Asks for changes to the answer in review. The agents redo it as a new round.",
        "operationId": "send_feedback_jobs__job_id__feedback_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Send Feedback",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/context/read_artifact": {
      "post": {
        "description": "Any artifact of this job, from any round. Others answer 404, the same as missing ones.",
        "operationId": "read_artifact_v1_context_read_artifact_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadArtifact"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactContent"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Artifact",
        "tags": [
          "context (agents only)"
        ]
      }
    },
    "/v1/context/write_artifact": {
      "post": {
        "description": "Saves the artifact in the token's round. The dispatcher later marks the answer FINAL.",
        "operationId": "write_artifact_v1_context_write_artifact_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteArtifact"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WrittenArtifact"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Write Artifact",
        "tags": [
          "context (agents only)"
        ]
      }
    }
  }
}
